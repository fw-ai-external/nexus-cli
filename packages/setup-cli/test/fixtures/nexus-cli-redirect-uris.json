{
  "description": "Canonical Nexus CLI sign-in redirect URI policy. Identical copies are kept in the CLI, the web app and the backend. A redirect URI is allowed if it equals one of 'exact', or if it is exactly 'loopback.scheme' + '://' + one of 'loopback.hosts' + ':' + a port + 'loopback.path', where the port is a decimal integer from 'loopback.minPort' to 'loopback.maxPort' with no sign and no leading zero (RFC 8252 section 7.3). Comparison is exact and case-sensitive; nothing is normalized. Each copy must implement this rule, accept every 'allowed' example and reject every 'rejected' entry. Change all copies together.",
  "version": 2,
  "exact": [
    "urn:ietf:wg:oauth:2.0:oob"
  ],
  "loopback": {
    "scheme": "http",
    "hosts": ["localhost", "127.0.0.1"],
    "path": "/callback",
    "minPort": 1024,
    "maxPort": 65535
  },
  "allowed": [
    "http://localhost:18000/callback",
    "http://127.0.0.1:18000/callback",
    "http://localhost:18001/callback",
    "http://127.0.0.1:18001/callback",
    "http://localhost:1024/callback",
