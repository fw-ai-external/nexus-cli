#!/bin/sh
# Stand-in for libsecret's secret-tool: one file per attribute set under $HOME.
db="$HOME/fake-secret-tool"
cmd=$1
[ "$cmd" = "--version" ] && { echo "secret-tool 0.21"; exit 0; }
shift
key=""
skip=0
for a in "$@"; do
  if [ $skip = 1 ]; then skip=0; continue; fi
  case "$a" in --label) skip=1 ;; --*) ;; *) key="$key/$a" ;; esac
done
f="$db/$(printf %s "$key" | sha256sum | cut -c1-16)"
case $cmd in
  store) mkdir -p "$db"; IFS= read -r v; printf %s "$v" > "$f" ;;
  lookup) [ -f "$f" ] || exit 1; cat "$f" ;;
  clear) [ -f "$f" ] || exit 1; rm -f "$f" ;;
  *) exit 2 ;;
esac
